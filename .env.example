# Copy this file to .env.local and fill in your values. .env.local is gitignored.

# Supabase (Project Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key (Project Settings -> API -> service_role). Server-only — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (Dashboard -> Settings -> API Keys). Server-only.
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Resend (resend.com dashboard -> API Keys). Server-only.
RESEND_API_KEY=your-resend-api-key
# Sandbox sender until a custom domain is verified with Resend.
RESEND_FROM_EMAIL=BetterBite <onboarding@resend.dev>
# Where admin "New Order" notifications are sent.
ADMIN_EMAIL=you@example.com
# Used for the "Continue Shopping" link in customer emails.
SITE_URL=https://betterbite-mu.vercel.app
